# 二進位與編譯產物
/claude-miniapp
/claude-miniapp.exe
*.exe
*.exe~
*.out
*.test

# 資料庫（含 WAL 模式的 -wal／-shm 附屬檔）
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# runner 落地的圖片（截圖等），跟 DB 一樣屬於執行期產物
/internal/static/uploads/

# 設定檔（含敏感資訊）
config.yaml
config.local.yaml
*.local.yaml

# 環境變數（含 .env.example，請自行維護本機範本）
.env
.env.*

# 作業系統
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Go 工具
vendor/

# POC 探測腳本與樣本：僅供本機調查/一次性驗證，不進版控
poc/

# POC live samples（可能含 OAuth 回應或 token 衍生資料）
poc/quota-percent/samples/claude-oauth-usage.json

# Kiro 本機 MCP／agent 設定（含絕對路徑，各開發者自行維護）
.kiro/

# 本機除錯產物
claude-miniapp-debug*.log
cursor-image-probe.*
add_logging.py

# slog/zap rotate 落地檔
/logs/

# runtime 工作區（使用者上傳等），不進版控
/workspace/

# ACP roundtrip 本機產出（含絕對路徑、sessionId、raw tool updates）
poc/kiro-cli/samples_acp_*.json
poc/kiro-cli/samples_acp_*.md
poc/kiro-cli/samples_kiro_msg*

# Spectra app data
.spectra/
docs/spectra/.vector-search.db*

# Agent & IDE 設定與 skills
.agents/
.claude/
.cursor/
.cursorrules
**/skills/


# Telegram 登入 session（帳號憑證）
/telegram.session
